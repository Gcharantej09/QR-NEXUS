rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone authenticated to read uploaded documents (officers need to view them)
    // Allow the owner to write
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == request.resource.metadata.userId;
      // Fallback: any authenticated user can write if no metadata check fails
      allow create: if request.auth != null;
    }
  }
}
